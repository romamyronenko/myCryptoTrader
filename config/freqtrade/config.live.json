{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "myCryptoTrader-live",
  "initial_state": "running",
  "max_open_trades": 2,
  "stake_currency": "USDT",
  "stake_amount": 25,
  "tradable_balance_ratio": 0.5,
  "dry_run": false,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "spot",
  "margin_mode": "",
  "timeframe": "1h",
  "db_url": "sqlite:////freqtrade/user_data/tradesv3.sqlite",
  "force_entry_enable": false,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "${BINANCE_API_KEY}",
    "secret": "${BINANCE_API_SECRET}",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": ["BTC/USDT", "ETH/USDT", "SOL/USDT"],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "${FREQTRADE_JWT_SECRET}",
    "CORS_origins": [],
    "username": "${FREQTRADE_API_USERNAME}",
    "password": "${FREQTRADE_API_PASSWORD}"
  },
  "telegram": {
    "enabled": false,
    "token": "${TELEGRAM_TOKEN}",
    "chat_id": "${TELEGRAM_CHAT_ID}"
  },
  "protections": [
    {
      "method": "StoplossGuard",
      "lookback_period_candles": 24,
      "trade_limit": 2,
      "stop_duration_candles": 12,
      "only_per_pair": false
    },
    {
      "method": "MaxDrawdown",
      "lookback_period_candles": 200,
      "trade_limit": 10,
      "stop_duration_candles": 24,
      "max_allowed_drawdown": 0.1
    }
  ],
  "internals": {
    "process_throttle_secs": 5
  }
}
