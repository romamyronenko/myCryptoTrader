# Copy to .env and fill in. .env is git-ignored.

# --- Local research / container defaults ---
EXCHANGE=binance
STAKE_CURRENCY=USDT
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=1h
FEE=0.001
INITIAL_CAPITAL=10000
STRATEGY=TaBaseline

# --- Host ports for FreqUI (bound to 127.0.0.1) ---
FREQTRADE_DRYRUN_PORT=18080
FREQTRADE_LIVE_PORT=18081

# --- Docker image pin (optional) ---
# Pin deliberately: config schema changes between Freqtrade releases.
# FREQTRADE_IMAGE=freqtradeorg/freqtrade:2026.10

# --- Live secrets ---
# API keys are NOT stored here. Freqtrade does not expand ${VARS} from .env.
# Use config/freqtrade/config.private.json instead:
#   cp config/freqtrade/config.private.example.json config/freqtrade/config.private.json
#   chmod 600 config/freqtrade/config.private.json
