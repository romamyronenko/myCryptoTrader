# Copy to .env and fill in. .env is git-ignored.

# --- Local research defaults ---
EXCHANGE=binance
STAKE_CURRENCY=USDT
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=1h
FEE=0.001
INITIAL_CAPITAL=10000

# --- Live exchange keys ---
# Create a key with TRADE permission only. NEVER enable withdrawals.
# Restrict it to your server IP on the exchange.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Freqtrade API server / FreqUI ---
FREQTRADE_API_USERNAME=freqtrader
FREQTRADE_API_PASSWORD=change-me
FREQTRADE_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Telegram (optional, recommended for live) ---
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Docker image pin (optional) ---
# FREQTRADE_IMAGE=freqtradeorg/freqtrade:stable
